<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400">
  <rect width="600" height="400" fill="#1e293b"/>
  <!-- Streetlight pole -->
  <path d="M 300 400 L 300 120 Q 300 80 340 80 L 380 80" stroke="#64748b" stroke-width="12" fill="none"/>
  <!-- Luminaire head -->
  <rect x="370" y="70" width="50" height="20" rx="4" fill="#94a3b8"/>
  <polygon points="370,90 420,90 450,220 340,220" fill="#fef08a" opacity="0.15"/>
  <text x="300" y="45" fill="#f8fafc" font-family="sans-serif" font-size="22" font-weight="bold" text-anchor="middle">BROKEN STREETLIGHT</text>
  <rect x="270" y="60" width="180" height="180" fill="none" stroke="#d97706" stroke-width="2" stroke-dasharray="6,4"/>
  <rect x="270" y="40" width="180" height="20" fill="#d97706" rx="2"/>
  <text x="278" y="55" fill="#ffffff" font-family="sans-serif" font-size="11" font-weight="bold">LIGHTING DEFECT 85%</text>
</svg>
