<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400">
  <rect width="600" height="400" fill="#334155"/>
  <!-- Pole tilted -->
  <line x1="280" y1="380" x2="340" y2="160" stroke="#94a3b8" stroke-width="12"/>
  <!-- Bent Stop sign -->
  <g transform="translate(350, 150) rotate(-22)">
    <polygon points="0,-60 42,-42 60,0 42,42 0,60 -42,42 -60,0 -42,-42" fill="#dc2626" stroke="#ffffff" stroke-width="4"/>
    <text x="0" y="8" fill="#ffffff" font-family="sans-serif" font-size="22" font-weight="900" text-anchor="middle">STOP</text>
  </g>
  <text x="300" y="50" fill="#f8fafc" font-family="sans-serif" font-size="22" font-weight="bold" text-anchor="middle">DAMAGED REGULATORY SIGN</text>
  <rect x="250" y="70" width="180" height="240" fill="none" stroke="#d97706" stroke-width="2" stroke-dasharray="6,4"/>
  <rect x="250" y="50" width="140" height="20" fill="#d97706" rx="2"/>
  <text x="258" y="65" fill="#ffffff" font-family="sans-serif" font-size="11" font-weight="bold">BENT SIGN 82%</text>
</svg>
